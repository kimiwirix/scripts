pm <- merge(p, m, by = "label_final")%>%
melt(id = c('label_final', 'timepoint', 'community', 'techrep', 'temp', 'repbio', 'batch', 'label', 'hrs'),
variable.name = 'strain', value.name = 'rel_abd') %>%
select(!c("label", "techrep", "batch"))
