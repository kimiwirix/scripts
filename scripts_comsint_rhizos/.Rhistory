mutate(contamination=case_when(
presence==0 & rel_abd==0 ~ real_name,
presence==1 & rel_abd>0 ~ real_name,
TRUE  ~ 'Contamination'
)) %>%
filter(!(contamination=="Contamination" & rel_abd ==0))
